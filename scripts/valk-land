#!/usr/bin/env bash
#
# valk-land — land a finished valk/<name> branch onto the main branch
# (issue 0019, tracer / local clean path). Run from the MAIN checkout:
#
#   fetch → rebase valk/<name> (in its linked worktree) onto fresh
#   origin/main → fast-forward main → sync-safe push.
#
# Linear history; never force-pushes, never rewrites already-pushed history.
# Companion to valk-worktree: valk-land <name> ↔ branch valk/<name> ↔
# worktree ../<repo>-<name>. Language-agnostic and standalone.
#
set -u

name=""
no_push=0
force=0
for arg in "$@"; do
  case "$arg" in
    --no-push) no_push=1 ;;
    --force) force=1 ;;
    -*) echo "valk-land: unknown option: $arg" >&2; exit 2 ;;
    *) [ -n "$name" ] && { echo "valk-land: unexpected argument: $arg" >&2; exit 2; }
       name="$arg" ;;
  esac
done
[ -n "$name" ] || { echo "usage: valk-land <name> [--no-push]" >&2; exit 2; }

root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "valk-land: not inside a git repository" >&2; exit 1; }
branch="valk/$name"

# Resolve our sibling read-valk-config.sh (read-only reuse; resolve one
# symlink level — install.sh symlinks an absolute path; macOS has no
# readlink -f).
self="$0"
if [ -L "$self" ]; then
  link="$(readlink "$self")"
  case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
fi
RVC="$(cd "$(dirname "$self")" && pwd)/read-valk-config.sh"

git -C "$root" rev-parse --verify -q "refs/heads/$branch" >/dev/null || {
  echo "valk-land: no branch $branch" >&2; exit 1; }

# Must run from the main checkout (we fast-forward main here). Refusing from
# inside the branch's own worktree mirrors valk-worktree --remove's stance.
cur="$(git -C "$root" rev-parse --abbrev-ref HEAD 2>/dev/null)"
if [ "$cur" = "$branch" ]; then
  echo "valk-land: run this from the main checkout, not from inside the $branch worktree" >&2
  exit 2
fi

git -C "$root" fetch -q origin || { echo "valk-land: git fetch failed" >&2; exit 1; }

# Locate the linked worktree that has valk/<name> checked out and rebase it
# there — the branch is rebased where it lives, so this is worktree-safe and
# never fights a "branch already checked out" error.
wt="$(git -C "$root" worktree list --porcelain \
      | awk -v b="branch refs/heads/$branch" '
          /^worktree /{p=substr($0,10)} $0==b{print p; exit}')"
[ -n "$wt" ] || {
  echo "valk-land: $branch is not checked out in a worktree — create one with 'valk-worktree $name'" >&2
  exit 1; }

if ! git -C "$wt" rebase -q origin/main; then
  git -C "$wt" rebase --abort >/dev/null 2>&1
  {
    echo "valk-land: rebase of $branch onto origin/main hit a conflict."
    echo "Nothing was changed — $branch and its worktree are exactly as before,"
    echo "origin/main is untouched. valk-land does not auto-resolve. Resolve it"
    echo "by hand in the worktree, then re-run:"
    echo
    echo "  cd $wt"
    echo "  git rebase origin/main      # redo the rebase, fix the conflicts"
    echo "  # …edit files, git add, git rebase --continue (or --abort to back out)"
    echo "  valk-land $name             # re-run once the rebase is clean"
  } >&2
  exit 1
fi

# Local safety gate: the slice was green in its own worktree, but it has
# now been rebased onto a moved origin/main. Run the repo's GREEN signal
# (test_skill from .claude/valk-config.md, the same key tdd consumes) on the
# REBASED tree before anything is finalized. valk-land is a script, so the
# only signal it can honor is an executable command; a red gate aborts the
# land (nothing finalized/pushed; the rebased work stays on the branch).
ts="$("$RVC" --repo "$root" test_skill 2>/dev/null || true)"
if [ -n "$ts" ] && command -v "$ts" >/dev/null 2>&1; then
  if ! ( cd "$wt" && "$ts" ); then
    echo "valk-land: the configured test gate ($ts) failed on the rebased $branch — not landing. Fix it in $wt, then re-run 'valk-land $name'." >&2
    exit 1
  fi
elif [ "$force" -eq 1 ]; then
  echo "valk-land: WARNING — no runnable test gate (test_skill=${ts:-unset}); landing $branch UNVERIFIED because --force was given." >&2
else
  echo "valk-land: no runnable test gate. Set 'test_skill: <command>' in .claude/valk-config.md so the rebased $branch is verified before landing, or re-run with --force to land unverified." >&2
  exit 1
fi

# Remember pre-land main so a refused push can be fully unwound (the local
# ff was never published, and valk/<name> keeps the rebased work).
pre_main="$(git -C "$root" rev-parse --verify -q main)" || {
  echo "valk-land: cannot resolve main at $root" >&2; exit 1; }

# Fast-forward main from the main checkout (main is checked out at $root).
# --ff-only can never create a merge commit or rewrite history.
git -C "$root" checkout -q main || { echo "valk-land: cannot checkout main at $root" >&2; exit 1; }
git -C "$root" merge --ff-only "$branch" || {
  echo "valk-land: main is not fast-forwardable from $branch" >&2; exit 1; }

if [ "$no_push" -eq 1 ]; then
  echo "✓ $branch landed on local main (--no-push: origin untouched)"
  exit 0
fi

if ! git -C "$root" push -q origin main; then
  # origin moved under us (a concurrent flow landed). Never force. Unwind
  # the unpublished local ff; valk/<name> keeps the rebased work.
  git -C "$root" reset --hard -q "$pre_main"
  echo "valk-land: origin/main moved (a concurrent land won). Nothing was force-pushed; your work is safe on $branch. Re-run 'valk-land $name' to rebase on the new origin/main and try again." >&2
  exit 1
fi

echo "✓ landed $branch onto origin/main"
